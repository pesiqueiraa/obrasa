# Leitura pública do banco (chave anônima; as tabelas têm RLS só de leitura).
# Local: valores de `supabase status -o env` (API_URL e ANON_KEY).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
# Opcional: pasta de config/ (padrão: ../../config a partir de apps/web)
# CONFIG_DIR=
# Endereço público do site (links das imagens de compartilhamento). Padrão: http://localhost:3000
# SITE_URL=https://endereco-do-site
